# Copy this file to `.env` (in the repo root) and fill in your key.
#
# A key is required ONLY for the AI-powered stages:
#   - the VLM seed-inference stage in rl_seed_pipeline (vlm.py), and
#   - the LLM success judge in rl_env (harness/judge.py).
#
# Everything else — the deterministic pipeline stages, the simulated apps,
# the grader's deterministic fallback, and the offline tests — runs WITHOUT
# any key. The judge/VLM degrade gracefully when the key is absent.

OPENAI_API_KEY=sk-your-openai-key-here

# --- Optional: use Azure OpenAI for the VLM stage instead of OpenAI ---
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
