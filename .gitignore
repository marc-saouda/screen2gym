# ---------------------------------------------------------------------------
# Secrets — never commit the real API key. Use .env.example as the template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Large media. The sample screen recording is ~313 MB (over GitHub's 100 MB
# file limit); it is intentionally not shipped. The pipeline still runs from
# the committed event stream; the VLM stage needs a recording or live frames.
# ---------------------------------------------------------------------------
*.webm
*.mp4
*.mov
rl_seed_pipeline/outputs/recording.webm

# ---------------------------------------------------------------------------
# Recording key-frame stills — regenerable from the input and excluded for
# privacy (they are screen captures). The manifest (labels/offsets) is kept.
# ---------------------------------------------------------------------------
rl_seed_pipeline/outputs/keyframes/*.jpg
rl_seed_pipeline/outputs/keyframes/*.jpeg
rl_seed_pipeline/outputs/keyframes/*.png

# ---------------------------------------------------------------------------
# Transient RL-env run artifacts (regenerated by the tests). Keep only the
# three curated showcase screenshots used by the README.
# ---------------------------------------------------------------------------
rl_env/outputs/server.log
rl_env/outputs/*_report.json
rl_env/outputs/*.html
rl_env/outputs/[0-9][0-9]_*.png
rl_env/outputs/shots/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
.cursor/
