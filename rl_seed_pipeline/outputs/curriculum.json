{
  "task": {
    "title": "Automate Booking Alerts from Google Sheets to Slack",
    "summary": "The user set up an automation to send real-time booking alerts from a Google Sheets document to a Slack channel. This involved configuring a Zap in Zapier to trigger when a new row is added to the Google Sheet, and then sending a formatted message to a Slack channel.",
    "goal": "Create a Zapier automation that sends new booking details from Google Sheets to a Slack channel.",
    "domain": "business-automation",
    "applications": [
      "Google Chrome",
      "Google Sheets",
      "Zapier",
      "Slack"
    ],
    "steps": [
      "Open Google Sheets and create a new spreadsheet for bookings.",
      "Set up a Zap in Zapier to trigger on new spreadsheet rows.",
      "Configure the Zap to send a message to a Slack channel with booking details.",
      "Test the Zap to ensure it sends messages correctly."
    ],
    "success_criteria": [
      "A new row in Google Sheets triggers a Slack message.",
      "The Slack message contains correct booking details.",
      "The Zap runs successfully without errors."
    ]
  },
